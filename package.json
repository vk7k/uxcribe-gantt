{
  "name": "uxcribe-gantt",
  "version": "1.0.0",
  "description": "Collaborative Gantt chart with Trello-style rich task cards, real-time sync, and MySQL ORM",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "setup": "npx prisma db push && node prisma/seed.js",
    "build": "prisma generate && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0"
  }
}